{
	"name": "clippy-ai-assistant",
	"version": "1.0.0",
	"description": "AI-powered personal assistant for Obsidian with multi-provider support",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"ai",
		"assistant",
		"automation",
		"enhancement"
	],
	"author": "CLIPPY Team",
	"license": "MIT",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.27.0",
		"node-fetch": "^2.7.0",
		"openai": "^4.26.0"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@typescript-eslint/eslint-plugin": "6.15.0",
		"@typescript-eslint/parser": "6.15.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.19.10",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.3.3"
	}
}
